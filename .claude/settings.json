{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
